{
  "name": "master-eye",
  "version": "1.0.0",
  "private": true,
  "description": "MASTER EYE — real-time tactical global intelligence and surveillance dashboard",
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently -n web,telemetry -c cyan,magenta \"next dev\" \"npm run telemetry\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "telemetry": "node services/telemetry/index.js",
    "worker:webcams": "python3 workers/webcam_discovery.py --once",
    "worker:webcams:loop": "python3 workers/webcam_discovery.py",
    "db:up": "docker compose up -d postgis",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgis",
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down",
    "postinstall": "node scripts/copy-cesium.js"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "axios": "^1.13.6",
    "cesium": "^1.145.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "lucide-react": "^1.45.0",
    "next": "14.2.35",
    "pg": "^8.23.0",
    "react": "^18",
    "react-dom": "^18",
    "resium": "^1.26.0",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.20.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/cesium": "^1.67.14",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
