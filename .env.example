# MASTER EYE — Environment Configuration
# Copy to .env.local for Next.js and source for workers/services

# Database (PostGIS)
DATABASE_URL=postgresql://mastereye:mastereye_dev@localhost:5432/mastereye

# Cesium Ion (optional — Natural Earth imagery used when unset)
# Must be NEXT_PUBLIC_ so the Cesium client bundle can read it.
NEXT_PUBLIC_CESIUM_ION_TOKEN=
CESIUM_ION_TOKEN=

# OpenSky Network OAuth2 (optional — anonymous rate-limited access works)
# Create an API client at https://opensky-network.org/my-opensky/account
# and paste values from the downloaded credentials.json
# That file is ALL you need from OpenSky (clientId + clientSecret).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Optional: semicolon-separated lamin,lomin,lamax,lomax tiles (keep each ≤25 sq° = 1 credit)
# OPENSKY_BBOXES=40.4,-74.5,41.2,-73.5;33.7,-118.7,34.4,-117.8
# TELEMETRY_POLL_MS=30000
# Legacy Basic auth (retired by OpenSky March 2026 — ignored)
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# ADSB Exchange RapidAPI (optional fallback)
ADSB_RAPIDAPI_KEY=
ADSB_RAPIDAPI_HOST=adsbexchange-com1.p.rapidapi.com

# Shodan OSINT worker
SHODAN_API_KEY=
WORKER_DEMO_MODE=true
WORKER_INTERVAL_SEC=300

# Telemetry microservice
TELEMETRY_URL=http://localhost:4100
NEXT_PUBLIC_TELEMETRY_WS=ws://localhost:4100/ws

# App
NEXT_PUBLIC_APP_NAME=MASTER EYE
NEXT_PUBLIC_DEFAULT_RADIUS_MILES=25
