# MASTER EYE — Environment Configuration
# Copy to .env.local for Next.js and source for workers/services

# Database (PostGIS)
DATABASE_URL=postgresql://mastereye:mastereye_dev@localhost:5432/mastereye

# Cesium Ion (optional — Natural Earth imagery used when unset)
# Must be NEXT_PUBLIC_ so the Cesium client bundle can read it.
NEXT_PUBLIC_CESIUM_ION_TOKEN=
CESIUM_ION_TOKEN=

# OpenSky Network (optional — anonymous rate-limited access works)
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# ADSB Exchange RapidAPI (optional fallback)
ADSB_RAPIDAPI_KEY=
ADSB_RAPIDAPI_HOST=adsbexchange-com1.p.rapidapi.com

# Shodan OSINT worker
SHODAN_API_KEY=
WORKER_DEMO_MODE=true
WORKER_INTERVAL_SEC=300

# Telemetry microservice
TELEMETRY_URL=http://localhost:4100
NEXT_PUBLIC_TELEMETRY_WS=ws://localhost:4100/ws

# App
NEXT_PUBLIC_APP_NAME=MASTER EYE
NEXT_PUBLIC_DEFAULT_RADIUS_MILES=25
